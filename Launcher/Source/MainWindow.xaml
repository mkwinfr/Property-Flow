<Window x:Class="PropertyFlow.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PropertyFlow.Launcher"
        xmlns:util="clr-namespace:PropertyFlow.Launcher.Utilities"
        xmlns:controls="clr-namespace:PropertyFlow.Launcher.Controls"
        Title="PS Launcher" Height="900" Width="1200"
        Background="#1a1a1a" Foreground="#ffffff"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- Theme Tokens -->
        <SolidColorBrush x:Key="AppBackgroundBrush">
            <SolidColorBrush.Color>
                <Color>#0B111C</Color>
            </SolidColorBrush.Color>
        </SolidColorBrush>
        <LinearGradientBrush x:Key="AppBackgroundGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0E1624" Offset="0"/>
            <GradientStop Color="#0A1019" Offset="0.6"/>
            <GradientStop Color="#0B1421" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="PrimaryBrush" Color="#2D8CFF"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#10B981"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#9AA3B5"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#F14B6E"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#22C55E"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B"/>

        <SolidColorBrush x:Key="CardBrush" Color="#CC0F1726"/>
        <SolidColorBrush x:Key="InsetBrush" Color="#B30A101C"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#364152"/>
        <SolidColorBrush x:Key="BorderStrongBrush" Color="#4A5A73"/>
        <SolidColorBrush x:Key="NavGlassBrush" Color="#B311192A"/>

        <DropShadowEffect x:Key="CardShadow" Color="#1A5EAFFF" BlurRadius="18" Direction="270" ShadowDepth="6" Opacity="0.55"/>
        <DropShadowEffect x:Key="InsetShadow" Color="#802D384D" BlurRadius="12" ShadowDepth="1" Direction="90" Opacity="0.5"/>

        <!-- Converter -->
        <util:StatusBrushConverter x:Key="StatusBrushConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <util:EcgStateConverter x:Key="EcgStateConverter"/>

        <!-- Card Style -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0 0 0 16"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>

        <!-- Inset Panel Style (Logs) -->
        <Style x:Key="InsetCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource InsetBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Effect" Value="{StaticResource InsetShadow}"/>
        </Style>

        <!-- Pill Button Style -->
        <Style x:Key="PillButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#19355F"/>
            <Setter Property="Foreground" Value="#F5F7FB"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14 8"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="18"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
                    <Setter Property="Background" Value="#25507D"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#2D8CFF"/>
                    <Setter Property="BorderBrush" Value="#5EA6FF"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Pill Status Style -->
        <Style x:Key="PillStyle" TargetType="Border">
            <Setter Property="Background" Value="#1D2533"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="10 4"/>
            <Setter Property="Margin" Value="0 0 6 0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#66182640" BlurRadius="8" ShadowDepth="0" Opacity="0.6"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab Button Style (for navbar) -->
        <Style x:Key="TabButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#142035"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16 8"/>
            <Setter Property="Margin" Value="4 0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="#213B63"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="BorderBrush" Value="#4E8CFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource AppBackgroundGradient}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- Nav + Info Card -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Background="{StaticResource NavGlassBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Navbar -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0 0 12 0">
                    <RadioButton GroupName="NavTabs" Style="{StaticResource TabButtonStyle}" IsChecked="True" Cursor="Hand" x:Name="ServicesTab">Services</RadioButton>
                    <RadioButton GroupName="NavTabs" Style="{StaticResource TabButtonStyle}" Cursor="Hand" x:Name="PackagesTab">Packages</RadioButton>
                    <RadioButton GroupName="NavTabs" Style="{StaticResource TabButtonStyle}" Cursor="Hand" x:Name="LogsTab">Logs</RadioButton>
                </StackPanel>

                <!-- Machine Info -->
                <TextBlock Grid.Column="1"
                           Text="{Binding MachineNameDisplay}"
                           FontSize="12"
                           Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center"
                           Margin="0 0 12 0"/>

                <!-- Spacer -->
                <Grid Grid.Column="2"/>

                <!-- Actions -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Launch All Services"
                            Command="{Binding LaunchAllCommand}"
                            Style="{StaticResource PillButtonStyle}"
                            Background="#1A2D4F"
                            BorderBrush="#4E8CFF"
                            Margin="0 0 8 0"
                            Effect="{StaticResource CardShadow}"/>
                    <Button Content="Stop All Services"
                            Command="{Binding StopAllCommand}"
                            Style="{StaticResource PillButtonStyle}"
                            Background="#27121C"
                            BorderBrush="#F14B6E"
                            Effect="{StaticResource CardShadow}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsChecked, ElementName=ServicesTab, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
                <!-- Services content -->
                <ItemsControl ItemsSource="{Binding Services}">
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="300"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="300"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Left column -->
                                    <Border Grid.Column="0"
                                            Background="#CC121B2B"
                                            BorderBrush="{StaticResource BorderStrongBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="12"
                                            Margin="0 0 12 0">
                                        <StackPanel VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Config.Name}" FontSize="16" FontWeight="SemiBold" Margin="0 0 0 4"/>
                                            <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}">
                                                <Run Text="Port: "/>
                                                <Run Text="{Binding Config.Port}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Config.PublicUrl}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="Wrap"
                                                       ToolTip="{Binding Config.PublicUrl}"
                                                       Margin="0 0 0 8"/>

                                            <StackPanel Orientation="Horizontal" Margin="0 8 0 0">
                                                <Border Style="{StaticResource PillStyle}"
                                                        Background="{Binding Status.HasPublicReachability, Converter={StaticResource StatusBrushConverter}}">
                                                    <TextBlock Text="Public" FontSize="10"/>
                                                </Border>
                                                <Border Style="{StaticResource PillStyle}"
                                                        Background="{Binding Status.LocalStatus, Converter={StaticResource StatusBrushConverter}}">
                                                    <TextBlock Text="Local" FontSize="10"/>
                                                </Border>
                                            </StackPanel>

                                            <controls:EcgStrip Margin="0 10 0 0">
                                                <controls:EcgStrip.State>
                                                    <MultiBinding Converter="{StaticResource EcgStateConverter}">
                                                        <Binding Path="Status.HasPublicReachability"/>
                                                        <Binding Path="ButtonState"/>
                                                    </MultiBinding>
                                                </controls:EcgStrip.State>
                                            </controls:EcgStrip>
                                        </StackPanel>
                                    </Border>

                                    <!-- Middle column -->
                                    <Border Grid.Column="1"
                                            Style="{StaticResource InsetCardStyle}"
                                            Margin="16 0">
                                        <StackPanel>
                                            <TextBlock Text="Logs" FontSize="12" FontWeight="SemiBold" Margin="0 0 0 8" Foreground="{StaticResource MutedBrush}"/>
                                            <ListBox ItemsSource="{Binding Logs}"
                                                     Background="#120C1220"
                                                     Foreground="#CDE8FF"
                                                     FontFamily="Consolas"
                                                     FontSize="11"
                                                     BorderThickness="1"
                                                     BorderBrush="{StaticResource BorderBrush}"
                                                     MaxHeight="140">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </StackPanel>
                                    </Border>

                                    <!-- Right column -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <Button Content="{Binding LaunchLabel}"
                                                Command="{Binding DataContext.LaunchServiceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding CanLaunch}"
                                                Style="{StaticResource PillButtonStyle}"
                                                Background="#1F3A63"
                                                BorderBrush="#4E8CFF"
                                                Margin="0 0 0 8"/>
                                        <Button Content="Open Local"
                                                Command="{Binding DataContext.OpenLocalCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource PillButtonStyle}"
                                                Background="#182336"
                                                BorderBrush="{StaticResource BorderStrongBrush}"
                                                Margin="0 0 0 8"/>
                                        <Button Content="Open Public"
                                                Command="{Binding DataContext.OpenPublicCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource PillButtonStyle}"
                                                Background="#182336"
                                                BorderBrush="{StaticResource BorderStrongBrush}"
                                                Margin="0 0 0 8"/>
                                        <Button Content="Stop"
                                                Command="{Binding DataContext.StopServiceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding CanStop}"
                                                Style="{StaticResource PillButtonStyle}"
                                                Background="#281321"
                                                BorderBrush="{StaticResource DangerBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Tunnel Card -->
                <Border Style="{StaticResource CardStyle}" HorizontalAlignment="Stretch">
                    <Grid HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="300"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="#CC121B2B"
                                BorderBrush="{StaticResource BorderStrongBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="12"
                                Margin="0 0 12 0">
                            <StackPanel VerticalAlignment="Top">
                                <TextBlock Text="Tunnel" FontSize="16" FontWeight="SemiBold" Margin="0 0 0 4"/>
                                <TextBlock Text="{Binding TunnelStatus.Status.ProcessDetails}"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="11"
                                           Margin="0 0 0 8"
                                           TextWrapping="Wrap"/>

                                <StackPanel Orientation="Horizontal" Margin="0 8 0 0">
                                    <Border Style="{StaticResource PillStyle}"
                                            Background="{Binding TunnelStatus.HasPublicReachability, Converter={StaticResource StatusBrushConverter}}">
                                        <TextBlock Text="Public" FontSize="10"/>
                                    </Border>
                                    <Border Style="{StaticResource PillStyle}"
                                            Background="{Binding TunnelStatus.IsProcessRunning, Converter={StaticResource StatusBrushConverter}}">
                                        <TextBlock Text="Process" FontSize="10"/>
                                    </Border>
                                </StackPanel>

                                <controls:EcgStrip Margin="0 10 0 0">
                                    <controls:EcgStrip.State>
                                        <MultiBinding Converter="{StaticResource EcgStateConverter}">
                                            <Binding Path="TunnelStatus.HasPublicReachability"/>
                                            <Binding Path="TunnelStatus.IsProcessRunning"/>
                                        </MultiBinding>
                                    </controls:EcgStrip.State>
                                </controls:EcgStrip>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1"
                                Style="{StaticResource InsetCardStyle}"
                                Margin="16 0">
                            <StackPanel>
                                <TextBlock Text="Logs" FontSize="12" FontWeight="SemiBold" Margin="0 0 0 8"/>
                                <TextBlock Text="{Binding TunnelStatus.Status.PublicSummary}"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <Button Content="Launch Tunnel"
                                    Command="{Binding LaunchTunnelCommand}"
                                    Style="{StaticResource PillButtonStyle}"
                                    Margin="0 0 0 8"/>
                            <Button Content="Open Public"
                                    Command="{Binding OpenPublicCommand}"
                                    CommandParameter="{Binding DataContext.TunnelStatus, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Style="{StaticResource PillButtonStyle}"
                                    Background="#5a5a5a"
                                    Margin="0 0 0 8"/>
                        </StackPanel>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Packages content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsChecked, ElementName=PackagesTab, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
                <Button Content="Refresh Packages"
                        Command="{Binding RefreshPackagesCommand}"
                        Style="{StaticResource PillButtonStyle}"
                        Background="{StaticResource AccentBrush}"
                        Margin="0 0 0 16"
                        HorizontalAlignment="Left"/>

                <ItemsControl ItemsSource="{Binding PackageProjects}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding WorkingDirectory}" Foreground="{StaticResource MutedBrush}" FontSize="11"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding WorkingDirectory}"/>
                                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0 4 0 8"/>
                                    <TextBlock Text="Declared Dependencies" FontWeight="SemiBold" Margin="0 0 0 4"/>
                                    <ItemsControl ItemsSource="{Binding Declared}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0 2 0 2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="120"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   TextWrapping="NoWrap"
                                                                   ToolTip="{Binding Name}"
                                                                   MaxWidth="200"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Text=" (dev)"
                                                                   Foreground="{StaticResource MutedBrush}"
                                                                   Visibility="{Binding IsDev, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="1"
                                                            Width="1"
                                                            Height="14"
                                                            Background="{StaticResource BorderBrush}"
                                                            Opacity="0.65"
                                                            Margin="8 0"/>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding Version}"
                                                               Foreground="{StaticResource MutedBrush}"
                                                               FontFamily="Consolas"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Version}"
                                                               HorizontalAlignment="Right"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Launcher Logs content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsChecked, ElementName=LogsTab, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
                <Border Style="{StaticResource CardStyle}" HorizontalAlignment="Stretch">
                    <StackPanel>
                        <TextBlock Text="Launcher Events" FontSize="16" FontWeight="SemiBold" Margin="0 0 0 8"/>
                        <ListBox ItemsSource="{Binding LauncherLogs}"
                                 Background="#120C1220"
                                 Foreground="#CDE8FF"
                                 FontFamily="Consolas"
                                 FontSize="11"
                                 BorderThickness="1"
                                 BorderBrush="{StaticResource BorderBrush}"
                                 MaxHeight="400">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
