<UserControl x:Class="PropertyFlow.Launcher.Controls.EcgStrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Height="46"
             MinHeight="40"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <SolidColorBrush x:Key="EcgGreenBrush" Color="#55E8B0"/>
        <SolidColorBrush x:Key="EcgAmberBrush" Color="#F5C056"/>
        <SolidColorBrush x:Key="EcgRedBrush" Color="#F17878"/>
        <SolidColorBrush x:Key="ScanGlowGreen" Color="#99EAF7B0"/>
        <SolidColorBrush x:Key="ScanGlowAmber" Color="#99F5C056"/>

        <!-- Wave geometries (prebuilt variations) -->
        <PathGeometry x:Key="WaveGeometry1" Figures="M0,22 L12,22 14,12 16,32 20,22 32,22 36,8 40,36 46,22 62,22 66,14 70,30 76,22 90,22 94,10 98,34 104,22 120,22 126,18 132,26 140,22 156,22 160,12 164,32 168,22 184,22 188,14 192,30 198,22 214,22 218,10 222,34 228,22 244,22"/>
        <PathGeometry x:Key="WaveGeometry2" Figures="M0,22 L10,22 14,8 18,36 24,22 40,22 44,16 48,28 54,22 70,22 74,12 78,32 84,22 98,22 102,18 106,26 112,22 128,22 132,14 136,30 142,22 156,22 162,10 168,34 174,22 188,22 192,12 196,32 200,22 214,22 218,16 222,28 228,22 244,22"/>
        <PathGeometry x:Key="WaveGeometry3" Figures="M0,22 L8,22 12,14 16,30 22,22 36,22 40,10 44,34 50,22 66,22 72,18 78,26 86,22 102,22 106,12 110,32 114,22 130,22 134,16 138,28 144,22 160,22 164,14 168,30 174,22 188,22 194,10 200,34 206,22 222,22 226,18 230,26 236,22 252,22"/>
    </UserControl.Resources>

    <Border x:Name="LayoutRoot" ClipToBounds="True" Background="#0E1A2D" CornerRadius="12" Padding="6,4">
        <Border.RenderTransform>
            <TranslateTransform x:Name="JitterTransform"/>
        </Border.RenderTransform>

        <Grid>
            <Rectangle Fill="#0FFFFFFF" Opacity="0.08"/>
            <Rectangle VerticalAlignment="Top" Height="1" Opacity="0.25">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#33FFFFFF" Offset="0"/>
                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <Grid ClipToBounds="True">
                <Grid.Effect>
                    <DropShadowEffect Color="#50182640" BlurRadius="10" ShadowDepth="0" Opacity="0.4"/>
                </Grid.Effect>

                <Canvas x:Name="WaveCanvas" Height="44">
                    <!-- Primary set -->
                    <Path x:Name="Wave1" Data="{StaticResource WaveGeometry1}" Stroke="{Binding WaveStroke, ElementName=Root}" StrokeThickness="2" Opacity="0.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                        <Path.RenderTransform>
                            <TranslateTransform x:Name="Wave1Transform" X="0"/>
                        </Path.RenderTransform>
                    </Path>
                    <Path x:Name="Wave2" Data="{StaticResource WaveGeometry2}" Stroke="{Binding WaveStroke, ElementName=Root}" StrokeThickness="2" Opacity="0.4" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                        <Path.RenderTransform>
                            <TranslateTransform x:Name="Wave2Transform" X="-80"/>
                        </Path.RenderTransform>
                    </Path>
                    <Path x:Name="Wave3" Data="{StaticResource WaveGeometry3}" Stroke="{Binding WaveStroke, ElementName=Root}" StrokeThickness="2" Opacity="0.35" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                        <Path.RenderTransform>
                            <TranslateTransform x:Name="Wave3Transform" X="-160"/>
                        </Path.RenderTransform>
                    </Path>

                    <!-- Duplicate set for seamless loop -->
                    <Path x:Name="Wave1B" Data="{StaticResource WaveGeometry1}" Stroke="{Binding WaveStroke, ElementName=Root}" StrokeThickness="2" Opacity="0.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                        <Path.RenderTransform>
                            <TranslateTransform x:Name="Wave1BTransform" X="260"/>
                        </Path.RenderTransform>
                    </Path>
                    <Path x:Name="Wave2B" Data="{StaticResource WaveGeometry2}" Stroke="{Binding WaveStroke, ElementName=Root}" StrokeThickness="2" Opacity="0.4" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                        <Path.RenderTransform>
                            <TranslateTransform x:Name="Wave2BTransform" X="340"/>
                        </Path.RenderTransform>
                    </Path>
                    <Path x:Name="Wave3B" Data="{StaticResource WaveGeometry3}" Stroke="{Binding WaveStroke, ElementName=Root}" StrokeThickness="2" Opacity="0.35" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                        <Path.RenderTransform>
                            <TranslateTransform x:Name="Wave3BTransform" X="420"/>
                        </Path.RenderTransform>
                    </Path>

                    <Path x:Name="FlatLine" Data="M0,22 L280,22" Stroke="{StaticResource EcgRedBrush}" StrokeThickness="2" Opacity="0.65" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>

                    <Rectangle x:Name="ScanTail" Width="24" Height="4" RadiusX="3" RadiusY="3" Opacity="0.8" Canvas.Top="20" Fill="{Binding ScanHeadBrush, ElementName=Root}">
                        <Rectangle.OpacityMask>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00FFFFFF" Offset="0"/>
                                <GradientStop Color="#55FFFFFF" Offset="0.35"/>
                                <GradientStop Color="#AAFFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.OpacityMask>
                        <Rectangle.RenderTransform>
                            <TranslateTransform x:Name="ScanTailTransform"/>
                        </Rectangle.RenderTransform>
                        <Rectangle.Stroke>
                            <SolidColorBrush Color="#00FFFFFF"/>
                        </Rectangle.Stroke>
                    </Rectangle>
                    <Ellipse x:Name="ScanHead" Width="10" Height="10" Fill="{Binding ScanHeadBrush, ElementName=Root}" Opacity="0.95" Canvas.Top="17">
                        <Ellipse.RenderTransform>
                            <TranslateTransform x:Name="ScanHeadTransform"/>
                        </Ellipse.RenderTransform>
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#A0FFFFFF" BlurRadius="10" ShadowDepth="0" Opacity="0.9"/>
                        </Ellipse.Effect>
                    </Ellipse>
                </Canvas>
            </Grid>
        </Grid>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="EcgStates">
                <VisualState x:Name="GreenState">
                    <Storyboard RepeatBehavior="Forever">
                        <!-- Full ECG spike animation - slow continuous loop -->
                        <DoubleAnimation Storyboard.TargetName="Wave1Transform" Storyboard.TargetProperty="X" From="0" To="-260" Duration="0:0:6" />
                        <DoubleAnimation Storyboard.TargetName="Wave2Transform" Storyboard.TargetProperty="X" From="-80" To="-340" Duration="0:0:7" />
                        <DoubleAnimation Storyboard.TargetName="Wave3Transform" Storyboard.TargetProperty="X" From="-160" To="-420" Duration="0:0:8" />
                        <DoubleAnimation Storyboard.TargetName="Wave1BTransform" Storyboard.TargetProperty="X" From="260" To="0" Duration="0:0:6" />
                        <DoubleAnimation Storyboard.TargetName="Wave2BTransform" Storyboard.TargetProperty="X" From="340" To="80" Duration="0:0:7" />
                        <DoubleAnimation Storyboard.TargetName="Wave3BTransform" Storyboard.TargetProperty="X" From="420" To="160" Duration="0:0:8" />
                        <DoubleAnimation Storyboard.TargetName="ScanHeadTransform" Storyboard.TargetProperty="X" From="0" To="268" Duration="0:0:6" />
                        <DoubleAnimation Storyboard.TargetName="ScanTailTransform" Storyboard.TargetProperty="X" From="-12" To="256" Duration="0:0:6" />
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="FlatLine" Storyboard.TargetProperty="Visibility">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Collapsed}"/>
                        </ObjectAnimationUsingKeyFrames>
                        <DoubleAnimation Storyboard.TargetName="ScanHead" Storyboard.TargetProperty="Opacity" To="0.95" Duration="0:0:0.2"/>
                        <DoubleAnimation Storyboard.TargetName="ScanTail" Storyboard.TargetProperty="Opacity" To="0.6" Duration="0:0:0.2"/>
                        <DoubleAnimation Storyboard.TargetName="Wave1" Storyboard.TargetProperty="Opacity" To="0.6" Duration="0:0:0.2"/>
                        <DoubleAnimation Storyboard.TargetName="Wave2" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0:0:0.2"/>
                        <DoubleAnimation Storyboard.TargetName="Wave3" Storyboard.TargetProperty="Opacity" To="0.35" Duration="0:0:0.2"/>
                        <DoubleAnimation Storyboard.TargetName="Wave1B" Storyboard.TargetProperty="Opacity" To="0.6" Duration="0:0:0.2"/>
                        <DoubleAnimation Storyboard.TargetName="Wave2B" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0:0:0.2"/>
                        <DoubleAnimation Storyboard.TargetName="Wave3B" Storyboard.TargetProperty="Opacity" To="0.35" Duration="0:0:0.2"/>
                    </Storyboard>
                </VisualState>

                <VisualState x:Name="AmberState">
                    <Storyboard RepeatBehavior="Forever">
                        <!-- Slow spike animation with reduced waves - for starting/restarting -->
                        <DoubleAnimation Storyboard.TargetName="Wave1Transform" Storyboard.TargetProperty="X" From="0" To="-260" Duration="0:0:8" />
                        <DoubleAnimation Storyboard.TargetName="Wave1BTransform" Storyboard.TargetProperty="X" From="260" To="0" Duration="0:0:8" />
                        <DoubleAnimation Storyboard.TargetName="ScanHeadTransform" Storyboard.TargetProperty="X" From="0" To="268" Duration="0:0:8" />
                        <DoubleAnimation Storyboard.TargetName="ScanTailTransform" Storyboard.TargetProperty="X" From="-12" To="256" Duration="0:0:8" />
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="FlatLine" Storyboard.TargetProperty="Visibility">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Collapsed}"/>
                        </ObjectAnimationUsingKeyFrames>
                        <DoubleAnimation Storyboard.TargetName="ScanHead" Storyboard.TargetProperty="Opacity" To="0.85" Duration="0:0:0.2"/>
                        <DoubleAnimation Storyboard.TargetName="ScanTail" Storyboard.TargetProperty="Opacity" To="0.5" Duration="0:0:0.2"/>
                        <!-- Only show Wave1 for minimal spikes -->
                        <DoubleAnimation Storyboard.TargetName="Wave1" Storyboard.TargetProperty="Opacity" To="0.5" Duration="0:0:0.2"/>
                        <DoubleAnimation Storyboard.TargetName="Wave1B" Storyboard.TargetProperty="Opacity" To="0.5" Duration="0:0:0.2"/>
                        <!-- Hide other waves for amber state -->
                        <DoubleAnimation Storyboard.TargetName="Wave2" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                        <DoubleAnimation Storyboard.TargetName="Wave3" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                        <DoubleAnimation Storyboard.TargetName="Wave2B" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                        <DoubleAnimation Storyboard.TargetName="Wave3B" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                    </Storyboard>
                </VisualState>

                <VisualState x:Name="RedState">
                    <Storyboard>
                        <!-- ECG flatline for offline -->
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="FlatLine" Storyboard.TargetProperty="Visibility">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}"/>
                        </ObjectAnimationUsingKeyFrames>
                        <DoubleAnimation Storyboard.TargetName="ScanHead" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                        <DoubleAnimation Storyboard.TargetName="ScanTail" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                        <DoubleAnimation Storyboard.TargetName="Wave1" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                        <DoubleAnimation Storyboard.TargetName="Wave2" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                        <DoubleAnimation Storyboard.TargetName="Wave3" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                        <DoubleAnimation Storyboard.TargetName="Wave1B" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                        <DoubleAnimation Storyboard.TargetName="Wave2B" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                        <DoubleAnimation Storyboard.TargetName="Wave3B" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                        <DoubleAnimation Storyboard.TargetName="FlatLine" Storyboard.TargetProperty="Opacity" From="0.5" To="0.7" Duration="0:0:2" AutoReverse="True" RepeatBehavior="Forever"/>
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Border>
</UserControl>
