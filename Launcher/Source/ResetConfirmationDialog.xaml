<Window x:Class="PropertyFlow.Launcher.ResetConfirmationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reset Local Repository - DESTRUCTIVE ACTION"
        Height="320"
        Width="500"
        Background="#0B111C"
        Foreground="#FFFFFF"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True">
    <Border Background="#0B111C" BorderBrush="#F14B6E" BorderThickness="2" CornerRadius="14" Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Warning header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0 0 0 16">
                <TextBlock Text="⚠️" FontSize="24" Margin="0 0 12 0" VerticalAlignment="Top"/>
                <TextBlock Text="WARNING: DESTRUCTIVE ACTION" FontSize="16" FontWeight="Bold" Foreground="#F14B6E" VerticalAlignment="Top"/>
            </StackPanel>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0 0 0 16">
                <StackPanel>
                    <TextBlock Text="This action will PERMANENTLY delete ALL local changes and untracked files." 
                               FontSize="13" 
                               Foreground="#FFFFFF" 
                               TextWrapping="Wrap" 
                               Margin="0 0 0 12"/>
                    <TextBlock Text="The repository will be reset to its last committed state." 
                               FontSize="13" 
                               Foreground="#FFFFFF" 
                               TextWrapping="Wrap" 
                               Margin="0 0 0 12"/>
                    <TextBlock Text="This action CANNOT be undone." 
                               FontSize="13" 
                               Foreground="#F14B6E" 
                               FontWeight="Bold" 
                               TextWrapping="Wrap" 
                               Margin="0 0 0 12"/>

                    <!-- Confirmation input -->
                    <TextBlock Text="Type DELETE (case-sensitive) to confirm:" 
                               FontSize="12" 
                               Foreground="#9AA3B5" 
                               Margin="0 0 0 8"/>
                    <Border Background="#0A1019"
                            BorderBrush="#364152"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="0">
                        <TextBox x:Name="ConfirmationInput"
                                 Background="#0A1019"
                                 Foreground="#FFFFFF"
                                 BorderThickness="0"
                                 Padding="12 8"
                                 FontSize="12"
                                 FontFamily="Consolas"
                                 Height="40"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Click="CancelButton_Click"
                        Background="#182336"
                        Foreground="#FFFFFF"
                        BorderBrush="#364152"
                        BorderThickness="1"
                        Padding="16 10"
                        MinWidth="100"
                        Margin="0 0 12 0"
                        Cursor="Hand"/>
                <Button x:Name="ConfirmButton"
                        Content="RESET LOCAL REPO"
                        Click="ConfirmButton_Click"
                        Background="#8B0000"
                        Foreground="#FFFFFF"
                        BorderBrush="#F14B6E"
                        BorderThickness="2"
                        Padding="16 10"
                        MinWidth="140"
                        Cursor="Hand"
                        IsEnabled="False"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
