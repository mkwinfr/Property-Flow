# Local Development Environment Configuration
# This file is used for local development and can override .env

# Default to production API unless you explicitly override for local dev.
VITE_API_BASE_URL=https://api.propertysuite.net/api

# Uncomment to use local backend during development:
# VITE_API_BASE_URL=http://localhost:4000/api

# To use a laptop/LAN IP address:
# VITE_API_BASE_URL=http://192.168.x.x:4000/api
