generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}



/// High-level occupancy / unit status
enum OccupancyStatus {
  OCCUPIED
  NOTICE
  VACANT
  DOWN
}

/// Status of a work order
enum WorkOrderStatus {
  OPEN
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELED
}

/// Priority of a work order
enum WorkOrderPriority {
  LOW
  MEDIUM
  HIGH
  EMERGENCY
}

/// Type of work order
enum WorkOrderType {
  MAINTENANCE
  MAKE_READY
  VENDOR
  INSPECTION
  OTHER
}

/// Status of a make-ready turn or task
enum TurnStatus {
  PENDING
  VACANT
  IN_PROGRESS
  PENDING_REVIEW
  VACANT_READY
}

/// Type of turn
enum TurnType {
  STANDARD_MOVE_OUT
  TRANSFER
  RENOVATION
  SPECIAL
}

/// Priority level
enum PriorityLevel {
  LOW
  NORMAL
  HIGH
  DOWN_UNIT
}

/// Overall condition assessment
enum OverallCondition {
  EXCELLENT
  GOOD
  FAIR
  POOR
  SEVERE
}

/// Condition tags found during assessment
enum ConditionTag {
  HEAVY_TRASH
  ODORS
  PET_DAMAGE
  PESTS
  MOLD_MOISTURE
  SAFETY_ISSUES
  APPLIANCE_ISSUES
}

/// Work categories
enum WorkCategory {
  GENERAL_MAINTENANCE
  PAINT
  CLEANING
  FLOORING
  APPLIANCES
  HVAC
  PLUMBING
  ELECTRICAL
  PEST_CONTROL
  TRASH_OUT
  VENDOR_SPECIALTY
  OTHER
}

/// Task priority
enum TaskPriority {
  CRITICAL
  HIGH
  NORMAL
  LOW
}

/// Punch list item status
enum PunchListItemStatus {
  OPEN
  COMPLETE
}

/// Activity log action types for Turn lifecycle
enum TurnActivityType {
  ITEM_OPENED
  ITEM_COMPLETED
  ITEM_ADDED
  PUNCH_LIST_COMPLETED
  MANAGER_REVIEW_STARTED
  MANAGER_APPROVED
  MANAGER_REQUESTED_REWORK
  INVENTORY_USED
  COST_OVERRIDDEN
  APPLIANCE_UPDATED
  VENDOR_SERVICE_ADDED
  TURN_STATUS_CHANGED
}

/// Billable party
enum BillableParty {
  OWNER
  RESIDENT
  SHARED
  OTHER
}

/// Chargeback type
enum ChargebackType {
  NONE
  PARTIAL
  FULL
}

/// Task status
enum TaskStatusEnum {
  PENDING
  IN_PROGRESS
  DONE
  CANCELLED
}

/// Status of a vendor job
enum VendorJobStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELED
}

/// User roles for access control
enum UserRole {
  SUPER_ADMIN
  PROPERTY_MANAGER
  MAINTENANCE_TEAM
  VENDOR
  VIEWER
}

/// User account status
enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

/// Vendor status
enum VendorStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  BLACKLISTED
}

/// Department - organizational grouping of roles
model Department {
  id        Int      @id @default(autoincrement())
  key       String   @unique  // SCREAMING_SNAKE_CASE: EXECUTIVE_OWNERSHIP, PROPERTY_OPERATIONS, etc.
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles     Role[]
}

/// Role - job title / access level role
model Role {
  id            Int      @id @default(autoincrement())
  key           String   @unique  // SCREAMING_SNAKE_CASE: OWNER_PRINCIPAL, PROPERTY_MANAGER, etc.
  name          String
  description   String?
  departmentId  Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  department    Department      @relation(fields: [departmentId], references: [id])
  users         User[]
  permissions   RolePermission[]

  @@index([departmentId])
}

/// Permission - granular action permission
model Permission {
  id          Int      @id @default(autoincrement())
  key         String   @unique  // SCREAMING_SNAKE_CASE: ADMIN_USERS_VIEW, MAINTENANCE_WORKORDERS_UPDATE, etc.
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles       RolePermission[]
}

/// Junction table: Role -> Permissions
model RolePermission {
  roleId       Int
  permissionId Int
  createdAt    DateTime @default(now())

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([roleId])
}

/// Basic user account
model User {
  id                   Int                @id @default(autoincrement())
  name                 String
  email                String             @unique
  password             String?            // Hashed password
  roleId               Int?               // FK to Role
  status               UserStatus         @default(ACTIVE)
  propertyId           Int?               // Primary property (nullable for corporate)
  phone                String?
  userNotes            String?            // Scalar field: notes about user
  lastLoginAt          DateTime?
  passwordChangedAt    DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  
  // Legacy field - keep for backwards compatibility during migration
  userRole             UserRole           @default(VIEWER)

  // Relations
  role                 Role?              @relation(fields: [roleId], references: [id])
  workOrdersCreated    WorkOrder[]        @relation("WorkOrdersCreatedBy")
  workOrdersAssigned   WorkOrder[]        @relation("WorkOrdersAssignedTo")
  turnTasksAssigned    TurnTask[]         @relation("TurnTasksAssignedTo")
  maintenanceNotes     MaintenanceNote[]  @relation("MaintenanceNoteCreatedBy")
  activityLogs         ActivityLog[]
  auditLogs            AuditLog[]         @relation("AuditLogsCreatedBy")
  turnsCreated         Turn[]             @relation("TurnCreatedBy")
  turnsReviewed        Turn[]             @relation("TurnReviewedBy")
  punchListItemsAssigned    PunchListItem[] @relation("PunchListItemAssignedTo")
  punchListItemsCompleted   PunchListItem[] @relation("PunchListItemCompletedBy")
  turnActivityLogs     TurnActivityLog[]  @relation("TurnActivityCreatedBy")
  properties           UserProperty[]
  managedVendors       Vendor[]           @relation("VendorManagedBy")

  @@index([roleId])
  @@index([status])
}

/// A property / community
model Property {
  id         Int        @id @default(autoincrement())
  name       String
  code       String?    @unique
  address1   String?
  address2   String?
  city       String?
  state      String?
  postalCode String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  buildings  Building[]
  apartments Apartment[]
  userAccess UserProperty[]
}

/// A building / structure within a property
model Building {
  id             Int        @id @default(autoincrement())
  propertyId     Int
  buildingNumber String     // e.g., "100", "101", "Building A"
  name           String?    // Optional friendly name
  floors         Int?
  unitsPerFloor  Int?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  property       Property   @relation(fields: [propertyId], references: [id])
  apartments     Apartment[]

  @@unique([propertyId, buildingNumber])
  @@index([propertyId])
}

/// Floor plan definition (e.g., A1, B1, C1)
model FloorPlan {
  id              Int        @id @default(autoincrement())
  name            String     @unique  // Floor plan code: A1, A1.2, A1-P, B1, etc.
  type            String     // Tree/type name: Aspen, Hickory, Magnolia, etc.
  bedrooms        Int
  bathrooms       Float      // Allow decimal for half baths (e.g., 1.0, 2.0)
  marketRent      Float
  requiredDeposit Float
  sqFt            Int
  maxOccupancy    Int
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  apartments      Apartment[]
}

/// A specific apartment / unit
model Apartment {
  id           Int              @id @default(autoincrement())
  propertyId   Int
  buildingId   Int
  unitNumber   String
  building     String?          // Denormalized for backwards compatibility
  floor        Int?
  beds         Int?
  baths        Int?
  sqFt         Int?
  status       OccupancyStatus  @default(OCCUPIED)
  inlineNote   String?
  
  // New fields for floor plan and rent
  floorPlanId  Int?             // Foreign key to FloorPlan
  property     String?          // Property name (from CSV)
  minRent      Float?           // Minimum rent for this unit
  maxRent      Float?           // Maximum rent for this unit
  
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  propertyRel  Property         @relation(fields: [propertyId], references: [id])
  buildingRel  Building         @relation(fields: [buildingId], references: [id])
  floorPlan    FloorPlan?       @relation(fields: [floorPlanId], references: [id])

  workOrders   WorkOrder[]
  turns        Turn[]
  vendorJobs   VendorJob[]
  notes        MaintenanceNote[]
  attachments  Attachment[]
  activityLogs ActivityLog[]

  @@index([propertyId, unitNumber])
  @@index([floorPlanId])
}

/// Work order
model WorkOrder {
  id               Int               @id @default(autoincrement())
  apartmentId      Int
  createdByUserId  Int
  assignedToUserId Int?
  turnId           Int?

  type             WorkOrderType     @default(MAINTENANCE)
  status           WorkOrderStatus   @default(OPEN)
  priority         WorkOrderPriority @default(MEDIUM)

  summary          String
  description      String?
  requestedBy      String?
  requestedAt      DateTime?

  dueDate          DateTime?
  completedAt      DateTime?

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  apartment        Apartment         @relation(fields: [apartmentId], references: [id])
  createdBy        User              @relation("WorkOrdersCreatedBy", fields: [createdByUserId], references: [id])
  assignedTo       User?             @relation("WorkOrdersAssignedTo", fields: [assignedToUserId], references: [id])
  turn             Turn?             @relation(fields: [turnId], references: [id])

  vendorJobs       VendorJob[]
  attachments      Attachment[]

  @@index([apartmentId])
  @@index([status])
  @@index([type])
}

/// Make-ready turn
model Turn {
  id              Int        @id @default(autoincrement())
  propertyId      Int?
  unitId          Int?
  apartmentId     Int
  createdByUserId Int

  type            TurnType   @default(STANDARD_MOVE_OUT)
  status          TurnStatus @default(PENDING)
  priority        PriorityLevel @default(NORMAL)

  moveOutDate     DateTime?
  targetReadyDate DateTime?
  actualReadyDate DateTime?

  // Condition assessment
  overallCondition OverallCondition?
  wallsCondition   String?
  flooringCondition String?
  doorsLocksCondition String?
  plumbingCondition String?
  electricalCondition String?
  appliancesCondition String?
  cleanlinessCondition String?
  hasLifeSafetyIssues Boolean @default(false)
  lifeSafetyNotes String?
  photoNotes      String?

  // Scope & materials
  estimatedLaborCost Float?
  estimatedMaterialsCost Float?
  totalEstimatedCost Float?

  // Assignment & access
  turnOwnerId     String?
  accessInstructions String?
  alarmCodes      String?

  // Chargeback info
  chargebackType  ChargebackType @default(NONE)
  chargebackAmount Float?
  chargebackReason String?

  // Manager review fields
  managerReviewNotes String?
  reviewedByUserId Int?
  reviewedAt      DateTime?

  // General notes
  notes           String?
  turnNotes       String?

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  apartment       Apartment  @relation(fields: [apartmentId], references: [id])
  createdBy       User       @relation("TurnCreatedBy", fields: [createdByUserId], references: [id])
  reviewedBy      User?      @relation("TurnReviewedBy", fields: [reviewedByUserId], references: [id])

  tasks           TurnTask[]
  materials       TurnMaterial[]
  conditionTags   TurnConditionTag[]
  workCategories  TurnWorkCategory[]
  workOrders      WorkOrder[]
  attachments     Attachment[]
  punchListItems  PunchListItem[]
  activityLogs    TurnActivityLog[]
  costBreakdown   TurnCostBreakdown?

  @@index([apartmentId])
  @@index([status])
  @@index([priority])
}

/// Turn condition tags (junction table)
model TurnConditionTag {
  id      Int    @id @default(autoincrement())
  turnId  Int
  tag     ConditionTag

  turn    Turn   @relation(fields: [turnId], references: [id], onDelete: Cascade)

  @@unique([turnId, tag])
  @@index([turnId])
}

/// Turn work categories (junction table)
model TurnWorkCategory {
  id         Int    @id @default(autoincrement())
  turnId     Int
  category   WorkCategory

  turn       Turn   @relation(fields: [turnId], references: [id], onDelete: Cascade)

  @@unique([turnId, category])
  @@index([turnId])
}

/// Make-ready task
model TurnTask {
  id               Int        @id @default(autoincrement())
  turnId           Int
  title            String
  category         WorkCategory
  area             String     @default("WHOLE_UNIT")
  priority         TaskPriority @default(NORMAL)

  status           TaskStatusEnum @default(PENDING)
  assignedToUserId Int?
  sortOrder        Int        @default(0)

  // Effort & timing
  estimatedEffortValue Float?
  estimatedEffortUnit String?
  startDate        DateTime?
  dueDate          DateTime?
  mustCompleteBy   DateTime?
  isAllDay         Boolean    @default(false)
  startTime        String?
  endTime          String?

  // Notes & assignments
  internalNotes    String?
  vendorNotes      String?
  budgetedCost     Float?
  billableTo       BillableParty?
  assigneeType     String?    // IN_HOUSE, VENDOR
  vendorId         Int?
  dependsOnTaskId  Int?

  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  turn             Turn       @relation(fields: [turnId], references: [id], onDelete: Cascade)
  assignedTo       User?      @relation("TurnTasksAssignedTo", fields: [assignedToUserId], references: [id])

  @@index([turnId])
  @@index([status])
}

/// Make-ready materials
model TurnMaterial {
  id              Int      @id @default(autoincrement())
  turnId          Int
  item            String
  category        WorkCategory
  quantity        Float
  unit            String
  costPerUnit     Float?
  storeOrVendor   String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  turn            Turn     @relation(fields: [turnId], references: [id], onDelete: Cascade)

  @@index([turnId])
}

/// Punch list item for a turn
model PunchListItem {
  id              Int        @id @default(autoincrement())
  turnId          Int
  label           String
  area            String     @default("General")
  category        String     @default("General")
  status          PunchListItemStatus @default(OPEN)
  notes           String?
  assignedToUserId Int?
  
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  completedAt     DateTime?
  completedByUserId Int?

  turn            Turn       @relation(fields: [turnId], references: [id], onDelete: Cascade)
  assignedTo      User?      @relation("PunchListItemAssignedTo", fields: [assignedToUserId], references: [id])
  completedBy     User?      @relation("PunchListItemCompletedBy", fields: [completedByUserId], references: [id])
  inventoryUsages PunchItemInventoryUsage[]

  @@index([turnId])
  @@index([status])
}

/// Inventory item (parts tracking)
model InventoryItem {
  id              Int        @id @default(autoincrement())
  name            String
  sku             String     @unique
  tags            String[]   // ["Plumbing", "Faucets", "Kitchen"]
  category        WorkCategory
  quantity        Int
  unitCost        Float
  supplier        String?
  lastRestocked   DateTime?
  
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  punchItemUsages PunchItemInventoryUsage[]

  @@index([category])
}

/// Junction table: Punch List Item uses multiple Inventory Items
model PunchItemInventoryUsage {
  id                Int        @id @default(autoincrement())
  punchListItemId   Int
  inventoryItemId   Int
  quantityUsed      Int
  unitCost          Float      // Snapshot of cost at time of usage
  costOverride      Float?     // Manager can override cost
  
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  punchListItem     PunchListItem  @relation(fields: [punchListItemId], references: [id], onDelete: Cascade)
  inventoryItem     InventoryItem  @relation(fields: [inventoryItemId], references: [id])

  @@unique([punchListItemId, inventoryItemId])
  @@index([punchListItemId])
  @@index([inventoryItemId])
}

/// Cost breakdown for a turn
model TurnCostBreakdown {
  id                Int        @id @default(autoincrement())
  turnId            Int        @unique
  laborCost         Float      @default(0)
  materialsCost     Float      @default(0)
  vendorServicesCost Float     @default(0)
  totalCost         Float      @default(0)
  
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  turn              Turn       @relation(fields: [turnId], references: [id], onDelete: Cascade)

  @@index([turnId])
}

/// Activity log for turn lifecycle
model TurnActivityLog {
  id                Int        @id @default(autoincrement())
  turnId            Int
  userId            Int?
  activityType      TurnActivityType
  punchListItemId   Int?
  inventoryItemId   Int?
  details           Json?      // Can store additional data like quantities, costs, etc.
  
  createdAt         DateTime   @default(now())

  turn              Turn       @relation(fields: [turnId], references: [id], onDelete: Cascade)
  user              User?      @relation("TurnActivityCreatedBy", fields: [userId], references: [id])

  @@index([turnId])
  @@index([activityType])
  @@index([createdAt])
}

/// Vendors
model Vendor {
  id              Int           @id @default(autoincrement())
  name            String
  contactName     String?
  phone           String?
  email           String?
  notes           String?
  status          VendorStatus  @default(ACTIVE)
  specialties     String[]      // ["PAINTING", "PLUMBING", etc.]
  ratingScore     Float?
  managedByUserId Int?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  jobs            VendorJob[]
  managedBy       User?         @relation("VendorManagedBy", fields: [managedByUserId], references: [id])
}

/// Vendor job
model VendorJob {
  id            Int             @id @default(autoincrement())
  apartmentId   Int
  vendorId      Int
  workOrderId   Int?

  status        VendorJobStatus @default(SCHEDULED)
  scopeOfWork   String
  scheduledDate DateTime?
  completedDate DateTime?
  invoiceAmount Float?
  invoiceNumber String?

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  apartment     Apartment       @relation(fields: [apartmentId], references: [id])
  vendor        Vendor          @relation(fields: [vendorId], references: [id])
  workOrder     WorkOrder?      @relation(fields: [workOrderId], references: [id])

  @@index([apartmentId])
  @@index([vendorId])
}

/// Notes on an apartment
model MaintenanceNote {
  id            Int      @id @default(autoincrement())
  apartmentId   Int
  createdByUserId Int

  body          String
  pinned        Boolean @default(false)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  apartment     Apartment @relation(fields: [apartmentId], references: [id])
  createdBy     User      @relation("MaintenanceNoteCreatedBy", fields: [createdByUserId], references: [id])

  @@index([apartmentId])
}

/// Attachments (photos, PDFs, etc.)
model Attachment {
  id            Int      @id @default(autoincrement())
  apartmentId   Int
  workOrderId   Int?
  turnId        Int?

  fileUrl       String
  fileName      String?
  fileType      String?

  createdAt     DateTime @default(now())

  apartment     Apartment @relation(fields: [apartmentId], references: [id])
  workOrder     WorkOrder? @relation(fields: [workOrderId], references: [id])
  turn          Turn?      @relation(fields: [turnId], references: [id])

  @@index([apartmentId])
}

/// Activity timeline entries per apartment
model ActivityLog {
  id            Int      @id @default(autoincrement())
  apartmentId   Int
  userId        Int?
  type          String
  message       String
  createdAt     DateTime @default(now())

  apartment     Apartment @relation(fields: [apartmentId], references: [id])
  user          User?     @relation(fields: [userId], references: [id])

  @@index([apartmentId])
  @@index([createdAt])
}

/// User-Property access assignment
model UserProperty {
  userId     Int
  propertyId Int
  assignedAt DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@id([userId, propertyId])
}

/// Audit logs for system actions
model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?
  action     String   // "CREATE_USER", "EDIT_TURN", "DELETE_VENDOR", etc.
  tableName  String   // "User", "Turn", "Vendor"
  recordId   Int      // Which record was modified
  changes    Json?    // What changed: {field: {old: value, new: value}}
  ipAddress  String?
  createdAt  DateTime @default(now())

  user       User?    @relation("AuditLogsCreatedBy", fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}
