generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = "postgresql://postgres:Faker2029$@localhost:5432/property-flow?schema=public"
}


/// High-level occupancy / unit status
enum OccupancyStatus {
  OCCUPIED
  NOTICE
  VACANT
  DOWN
}

/// Status of a work order
enum WorkOrderStatus {
  OPEN
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELED
}

/// Priority of a work order
enum WorkOrderPriority {
  LOW
  MEDIUM
  HIGH
  EMERGENCY
}

/// Type of work order
enum WorkOrderType {
  MAINTENANCE
  MAKE_READY
  VENDOR
  INSPECTION
  OTHER
}

/// Status of a make-ready turn or task
enum TurnStatus {
  NOT_STARTED
  IN_PROGRESS
  READY
  ON_HOLD
}

/// Type of turn
enum TurnType {
  STANDARD_MOVE_OUT
  TRANSFER
  RENOVATION
  SPECIAL
}

/// Priority level
enum PriorityLevel {
  LOW
  NORMAL
  HIGH
  DOWN_UNIT
}

/// Overall condition assessment
enum OverallCondition {
  EXCELLENT
  GOOD
  FAIR
  POOR
  SEVERE
}

/// Condition tags found during assessment
enum ConditionTag {
  HEAVY_TRASH
  ODORS
  PET_DAMAGE
  PESTS
  MOLD_MOISTURE
  SAFETY_ISSUES
  APPLIANCE_ISSUES
}

/// Work categories
enum WorkCategory {
  GENERAL_MAINTENANCE
  PAINT
  CLEANING
  FLOORING
  APPLIANCES
  HVAC
  PLUMBING
  ELECTRICAL
  PEST_CONTROL
  TRASH_OUT
  VENDOR_SPECIALTY
  OTHER
}

/// Task priority
enum TaskPriority {
  CRITICAL
  HIGH
  NORMAL
  LOW
}

/// Billable party
enum BillableParty {
  OWNER
  RESIDENT
  SHARED
  OTHER
}

/// Chargeback type
enum ChargebackType {
  NONE
  PARTIAL
  FULL
}

/// Task status
enum TaskStatusEnum {
  PENDING
  IN_PROGRESS
  DONE
  CANCELLED
}

/// Status of a vendor job
enum VendorJobStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELED
}

/// Basic user account
model User {
  id                 Int                @id @default(autoincrement())
  name               String
  email              String             @unique
  role               String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  // Relations
  workOrdersCreated  WorkOrder[]        @relation("WorkOrdersCreatedBy")
  workOrdersAssigned WorkOrder[]        @relation("WorkOrdersAssignedTo")
  turnTasksAssigned  TurnTask[]         @relation("TurnTasksAssignedTo")
  notes              MaintenanceNote[]
  activityLogs       ActivityLog[]

  // 🔥 REQUIRED opposite relation for Turn.createdBy
  turnsCreated       Turn[]
}

/// A property / community
model Property {
  id         Int        @id @default(autoincrement())
  name       String
  code       String?    @unique
  address1   String?
  address2   String?
  city       String?
  state      String?
  postalCode String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  buildings  Building[]
  apartments Apartment[]
}

/// A building / structure within a property
model Building {
  id             Int        @id @default(autoincrement())
  propertyId     Int
  buildingNumber String     // e.g., "100", "101", "Building A"
  name           String?    // Optional friendly name
  floors         Int?
  unitsPerFloor  Int?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  property       Property   @relation(fields: [propertyId], references: [id])
  apartments     Apartment[]

  @@unique([propertyId, buildingNumber])
  @@index([propertyId])
}

/// A specific apartment / unit
model Apartment {
  id           Int              @id @default(autoincrement())
  propertyId   Int
  buildingId   Int
  unitNumber   String
  building     String?          // Denormalized for backwards compatibility
  floor        Int?
  beds         Int?
  baths        Int?
  sqFt         Int?
  status       OccupancyStatus  @default(OCCUPIED)
  inlineNote   String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  property     Property         @relation(fields: [propertyId], references: [id])
  buildingRel  Building         @relation(fields: [buildingId], references: [id])

  workOrders   WorkOrder[]
  turns        Turn[]
  vendorJobs   VendorJob[]
  notes        MaintenanceNote[]
  attachments  Attachment[]
  activityLogs ActivityLog[]

  @@index([propertyId, unitNumber])
}

/// Work order
model WorkOrder {
  id               Int               @id @default(autoincrement())
  apartmentId      Int
  createdByUserId  Int
  assignedToUserId Int?
  turnId           Int?

  type             WorkOrderType     @default(MAINTENANCE)
  status           WorkOrderStatus   @default(OPEN)
  priority         WorkOrderPriority @default(MEDIUM)

  summary          String
  description      String?
  requestedBy      String?
  requestedAt      DateTime?

  dueDate          DateTime?
  completedAt      DateTime?

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  apartment        Apartment         @relation(fields: [apartmentId], references: [id])
  createdBy        User              @relation("WorkOrdersCreatedBy", fields: [createdByUserId], references: [id])
  assignedTo       User?             @relation("WorkOrdersAssignedTo", fields: [assignedToUserId], references: [id])
  turn             Turn?             @relation(fields: [turnId], references: [id])

  vendorJobs       VendorJob[]
  attachments      Attachment[]

  @@index([apartmentId])
  @@index([status])
  @@index([type])
}

/// Make-ready turn
model Turn {
  id              Int        @id @default(autoincrement())
  propertyId      Int?
  unitId          Int?
  apartmentId     Int
  createdByUserId Int

  type            TurnType   @default(STANDARD_MOVE_OUT)
  status          TurnStatus @default(NOT_STARTED)
  priority        PriorityLevel @default(NORMAL)

  moveOutDate     DateTime?
  targetReadyDate DateTime?
  actualReadyDate DateTime?

  // Condition assessment
  overallCondition OverallCondition?
  wallsCondition   String?
  flooringCondition String?
  doorsLocksCondition String?
  plumbingCondition String?
  electricalCondition String?
  appliancesCondition String?
  cleanlinessCondition String?
  hasLifeSafetyIssues Boolean @default(false)
  lifeSafetyNotes String?
  photoNotes      String?

  // Scope & materials
  estimatedLaborCost Float?
  estimatedMaterialsCost Float?
  totalEstimatedCost Float?

  // Assignment & access
  turnOwnerId     String?
  accessInstructions String?
  alarmCodes      String?

  // Chargeback info
  chargebackType  ChargebackType @default(NONE)
  chargebackAmount Float?
  chargebackReason String?

  // General notes
  notes           String?
  turnNotes       String?

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  apartment       Apartment  @relation(fields: [apartmentId], references: [id])
  createdBy       User       @relation(fields: [createdByUserId], references: [id])

  tasks           TurnTask[]
  materials       TurnMaterial[]
  conditionTags   TurnConditionTag[]
  workCategories  TurnWorkCategory[]
  workOrders      WorkOrder[]
  attachments     Attachment[]

  @@index([apartmentId])
  @@index([status])
  @@index([priority])
}

/// Turn condition tags (junction table)
model TurnConditionTag {
  id      Int    @id @default(autoincrement())
  turnId  Int
  tag     ConditionTag

  turn    Turn   @relation(fields: [turnId], references: [id], onDelete: Cascade)

  @@unique([turnId, tag])
  @@index([turnId])
}

/// Turn work categories (junction table)
model TurnWorkCategory {
  id         Int    @id @default(autoincrement())
  turnId     Int
  category   WorkCategory

  turn       Turn   @relation(fields: [turnId], references: [id], onDelete: Cascade)

  @@unique([turnId, category])
  @@index([turnId])
}

/// Make-ready task
model TurnTask {
  id               Int        @id @default(autoincrement())
  turnId           Int
  title            String
  category         WorkCategory
  area             String     @default("WHOLE_UNIT")
  priority         TaskPriority @default(NORMAL)

  status           TaskStatusEnum @default(PENDING)
  assignedToUserId Int?
  sortOrder        Int        @default(0)

  // Effort & timing
  estimatedEffortValue Float?
  estimatedEffortUnit String?
  startDate        DateTime?
  dueDate          DateTime?
  mustCompleteBy   DateTime?
  isAllDay         Boolean    @default(false)
  startTime        String?
  endTime          String?

  // Notes & assignments
  internalNotes    String?
  vendorNotes      String?
  budgetedCost     Float?
  billableTo       BillableParty?
  assigneeType     String?    // IN_HOUSE, VENDOR
  vendorId         Int?
  dependsOnTaskId  Int?

  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  turn             Turn       @relation(fields: [turnId], references: [id], onDelete: Cascade)
  assignedTo       User?      @relation("TurnTasksAssignedTo", fields: [assignedToUserId], references: [id])

  @@index([turnId])
  @@index([status])
}

/// Make-ready materials
model TurnMaterial {
  id              Int      @id @default(autoincrement())
  turnId          Int
  item            String
  category        WorkCategory
  quantity        Float
  unit            String
  costPerUnit     Float?
  storeOrVendor   String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  turn            Turn     @relation(fields: [turnId], references: [id], onDelete: Cascade)

  @@index([turnId])
}

/// Vendors
model Vendor {
  id          Int        @id @default(autoincrement())
  name        String
  contactName String?
  phone       String?
  email       String?
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  jobs        VendorJob[]
}

/// Vendor job
model VendorJob {
  id            Int             @id @default(autoincrement())
  apartmentId   Int
  vendorId      Int
  workOrderId   Int?

  status        VendorJobStatus @default(SCHEDULED)
  scopeOfWork   String
  scheduledDate DateTime?
  completedDate DateTime?
  invoiceAmount Float?
  invoiceNumber String?

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  apartment     Apartment       @relation(fields: [apartmentId], references: [id])
  vendor        Vendor          @relation(fields: [vendorId], references: [id])
  workOrder     WorkOrder?      @relation(fields: [workOrderId], references: [id])

  @@index([apartmentId])
  @@index([vendorId])
}

/// Notes on an apartment
model MaintenanceNote {
  id            Int      @id @default(autoincrement())
  apartmentId   Int
  createdByUserId Int

  body          String
  pinned        Boolean @default(false)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  apartment     Apartment @relation(fields: [apartmentId], references: [id])
  createdBy     User      @relation(fields: [createdByUserId], references: [id])

  @@index([apartmentId])
}

/// Attachments (photos, PDFs, etc.)
model Attachment {
  id            Int      @id @default(autoincrement())
  apartmentId   Int
  workOrderId   Int?
  turnId        Int?

  fileUrl       String
  fileName      String?
  fileType      String?

  createdAt     DateTime @default(now())

  apartment     Apartment @relation(fields: [apartmentId], references: [id])
  workOrder     WorkOrder? @relation(fields: [workOrderId], references: [id])
  turn          Turn?      @relation(fields: [turnId], references: [id])

  @@index([apartmentId])
}

/// Activity timeline entries per apartment
model ActivityLog {
  id            Int      @id @default(autoincrement())
  apartmentId   Int
  userId        Int?
  type          String
  message       String
  createdAt     DateTime @default(now())

  apartment     Apartment @relation(fields: [apartmentId], references: [id])
  user          User?     @relation(fields: [userId], references: [id])

  @@index([apartmentId])
  @@index([createdAt])
}
