{
  "name": "property-suite-backend",
  "version": "0.1.0",
  "description": "REST API server for Property Suite Pro - comprehensive property management platform",
  "main": "dist/index.js",
  "type": "commonjs",
  "author": "Property Flow Development Team",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mkwinfr/Property-Flow.git"
  },
  "keywords": [
    "property-management",
    "rest-api",
    "express",
    "typescript",
    "prisma"
  ],
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
